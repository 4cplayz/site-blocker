{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "1.0.0",
  "description": "A black zone for whole sites, and switches for image posts, video posts and short-form video on the others.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "webNavigation",
    "alarms",
    "tabs",
    "idle"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Site Blocker"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
